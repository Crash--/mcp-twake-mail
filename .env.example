# mcp-twake-mail: copy to .env for local development. Never commit real credentials.
JMAP_SESSION_URL=https://jmap.example.com/jmap/session

# Basic auth (default)
JMAP_AUTH_METHOD=basic
JMAP_USERNAME=your_username
JMAP_PASSWORD=your_password

# Or Bearer token
# JMAP_AUTH_METHOD=bearer
# JMAP_TOKEN=your_jwt_token

# Or OIDC (PKCE)
# JMAP_AUTH_METHOD=oidc
# JMAP_OIDC_ISSUER=https://sso.example.com
# JMAP_OIDC_CLIENT_ID=your_client_id
# JMAP_OIDC_SCOPE=openid profile email offline_access
# JMAP_OIDC_REDIRECT_URI=http://localhost:5678/callback

# Or token command (external broker printing an access token)
# JMAP_AUTH_METHOD=command
# JMAP_TOKEN_COMMAND=/usr/local/bin/my-token-broker token

# Optional
# JMAP_DEFAULT_FROM=jane.doe@example.com
# JMAP_SIGNATURE_PATH=~/.mcp-twake-mail/signature.md
JMAP_REQUEST_TIMEOUT=30000
LOG_LEVEL=info
